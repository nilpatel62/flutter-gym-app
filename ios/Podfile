# Uncomment this line to define a global platform for your project
platform :ios, '26.2'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
      ]
    end
  end
  
  # Fix GoogleDataTransport header includes to use angle brackets
  gdt_path = File.join(installer.sandbox.root, 'GoogleDataTransport', 'GoogleDataTransport', 'GDTCORLibrary', 'Public', 'GoogleDataTransport')
  umbrella_path = File.join(installer.sandbox.root, 'Target Support Files', 'GoogleDataTransport', 'GoogleDataTransport-umbrella.h')
  
  # Helper method to safely write file with permission fix
  def safe_write_file(file_path, content)
    return unless File.exist?(file_path)
    
    # Ensure file is writable
    File.chmod(0644, file_path) if File.exist?(file_path)
    
    begin
      File.open(file_path, 'w') { |file| file.puts content }
    rescue Errno::EACCES => e
      puts "Warning: Could not write to #{file_path}: #{e.message}"
      puts "Attempting to fix permissions..."
      system("chmod u+w '#{file_path}'")
      File.open(file_path, 'w') { |file| file.puts content }
    end
  end
  
  # Fix GDTCOREndpoints.h
  endpoints_file = File.join(gdt_path, 'GDTCOREndpoints.h')
  if File.exist?(endpoints_file)
    text = File.read(endpoints_file)
    text.gsub!(/#import "GDTCORTargets.h"/, '#import <GoogleDataTransport/GDTCORTargets.h>')
    safe_write_file(endpoints_file, text)
  end
  
  # Fix GDTCOREvent.h
  event_file = File.join(gdt_path, 'GDTCOREvent.h')
  if File.exist?(event_file)
    text = File.read(event_file)
    text.gsub!(/#import "GDTCOREventDataObject.h"/, '#import <GoogleDataTransport/GDTCOREventDataObject.h>')
    text.gsub!(/#import "GDTCORTargets.h"/, '#import <GoogleDataTransport/GDTCORTargets.h>')
    safe_write_file(event_file, text)
  end
  
  # Fix GDTCORTransport.h
  transport_file = File.join(gdt_path, 'GDTCORTransport.h')
  if File.exist?(transport_file)
    text = File.read(transport_file)
    text.gsub!(/#import "GDTCOREventTransformer.h"/, '#import <GoogleDataTransport/GDTCOREventTransformer.h>')
    text.gsub!(/#import "GDTCORTargets.h"/, '#import <GoogleDataTransport/GDTCORTargets.h>')
    safe_write_file(transport_file, text)
  end
  
  # Fix GoogleDataTransport.h
  gdt_main_file = File.join(gdt_path, 'GoogleDataTransport.h')
  if File.exist?(gdt_main_file)
    text = File.read(gdt_main_file)
    text.gsub!(/#import "([^"]+)\.h"/, '#import <GoogleDataTransport/\1.h>')
    safe_write_file(gdt_main_file, text)
  end
  
  # Fix umbrella header
  if File.exist?(umbrella_path)
    text = File.read(umbrella_path)
    text.gsub!(/#import "([^"]+)\.h"/, '#import <GoogleDataTransport/\1.h>')
    safe_write_file(umbrella_path, text)
  end
end
